# Resend API key for contact form (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxx

# Recipient email for contact form submissions
CONTACT_EMAIL_TO=andrew@keesamax.com

# "From" address — must be a verified domain in Resend
CONTACT_EMAIL_FROM=contact@keesamax.com

# Public site URL (used by next-sitemap and OG tags)
SITE_URL=https://www.keesamax.com

# Notion integration token — read-only access to the jobs database
# Create at https://www.notion.so/profile/integrations, then grant the
# integration access to the "Keesamax — Job Listings" page in Notion.
NOTION_TOKEN=ntn_xxxxxxxx

# Notion data source ID (UUID) for the jobs listings database.
# Named *_DATABASE_ID for historical reasons; the @notionhq/client v5 SDK
# treats this as a data source ID passed to notion.dataSources.query().
NOTION_JOBS_DATABASE_ID=00000000-0000-0000-0000-000000000000
